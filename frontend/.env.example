# Default to static sample preview. Set to "api" only when intentionally connecting a backend.
VITE_DATA_SOURCE=sample
# Keep empty for local API development to use Vite's proxy target below.
# For a hosted frontend, set this to the real public backend URL (never include secrets).
VITE_API_BASE_URL=
# Dev only: where the Vite dev server proxies /api when VITE_API_BASE_URL is empty.
VITE_DEV_PROXY_TARGET=http://localhost:8000
